#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
IMAGE_NAME="${IMAGE_NAME:-opencode-vm:latest}"
BUILD_CONTEXT="$ROOT_DIR/images/opencode-vm"
ARCHIVE="${ARCHIVE:-$ROOT_DIR/.opencode-vm.tar}"

if command -v docker >/dev/null 2>&1; then
  BUILDER=docker
elif command -v podman >/dev/null 2>&1; then
  BUILDER=podman
else
  echo "error: docker or podman is required to build the image" >&2
  exit 1
fi

if ! command -v msb >/dev/null 2>&1; then
  echo "error: msb is required to load the image into microsandbox" >&2
  exit 1
fi

build_args=()
if [[ -n ${GITHUB_TOKEN:-} ]]; then
  build_args+=(--build-arg "GITHUB_TOKEN=$GITHUB_TOKEN")
fi

"$BUILDER" build "${build_args[@]}" -t "$IMAGE_NAME" "$BUILD_CONTEXT"
"$BUILDER" save "$IMAGE_NAME" -o "$ARCHIVE"
msb image load --input "$ARCHIVE" --tag "$IMAGE_NAME"

echo "Loaded $IMAGE_NAME into microsandbox"
