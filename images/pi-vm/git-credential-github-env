#!/usr/bin/env bash
# Git credential protocol: return only a runtime GH_TOKEN, never persist it.
set -euo pipefail
[[ ${1:-} == get ]] || exit 0
protocol= host=
while IFS='=' read -r key value && [[ -n $key ]]; do
  case "$key" in
    protocol) protocol=$value ;;
    host) host=$value ;;
  esac
done
if [[ $protocol == https && $host == github.com && -n ${GH_TOKEN:-} ]]; then
  # Prevent credential-protocol injection through a malformed environment value.
  [[ $GH_TOKEN != *$'\n'* && $GH_TOKEN != *$'\r'* ]] || exit 1
  printf 'username=x-access-token\npassword=%s\n\n' "$GH_TOKEN"
fi
